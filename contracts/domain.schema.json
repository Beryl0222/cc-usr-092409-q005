{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "邻里课堂安全协作领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "ENROLLMENT_CONFIRMED",
        "STAFF_CLEARED",
        "SESSION_REASSIGNED",
        "PICKUP_CHANGED",
        "CASE_ESCALATED",
        "GUARDIANSHIP_RECORDED",
        "PICKUP_SCOPE_RECORDED",
        "NO_RELEASE_RECORDED",
        "EMERGENCY_CONTACTS_RECORDED",
        "SUPPORT_NEEDS_RECORDED",
        "SESSION_PLANNED",
        "STAFF_ASSIGNED",
        "SESSION_FROZEN",
        "CHILD_PLACED",
        "CHILD_TRANSFERRED",
        "CHECK_IN_RECORDED",
        "TEMP_GUARDIAN_REQUESTED",
        "TEMP_GUARDIAN_CONFIRMED",
        "HANDOVER_RECORDED",
        "RELEASE_REFUSED",
        "CONTENT_CONFLICT_FLAGGED",
        "CONFLICT_RESOLVED",
        "NOTIFICATION_SENT",
        "NOTIFICATION_CONFIRMED",
        "ESCALATION_RAISED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "child_enrollment",
        "site_session",
        "staff_assignment",
        "safeguarding_case"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
