{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "邻里课堂安全协作领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "ENROLLMENT_CONFIRMED",
        "STAFF_CLEARED",
        "SESSION_REASSIGNED",
        "PICKUP_CHANGED",
        "CASE_ESCALATED",
        "SITE_REGISTERED",
        "SESSION_FROZEN",
        "SESSION_CLOSED",
        "GUARDIANSHIP_RECORDED",
        "DELEGATION_RECORDED",
        "DELEGATE_WITHDRAWN",
        "NO_RELEASE_ISSUED",
        "NO_RELEASE_LIFTED",
        "EMERGENCY_CONTACTS_RECORDED",
        "TEMP_CHANGE_VERIFIED",
        "TEMP_CHANGE_REJECTED",
        "TEMP_CHANGE_EXPIRED",
        "CHILD_CHECKED_IN",
        "CHILD_CHECKED_OUT",
        "PICKUP_REFUSED",
        "DELIVERY_FROZEN",
        "DELIVERY_UNFROZEN",
        "RECORD_REVISION_VERIFIED",
        "RECORD_REVISION_REJECTED",
        "TRANSFER_REQUESTED",
        "TRANSFER_APPROVED",
        "TRANSFER_REJECTED",
        "TRANSFER_COMPLETED",
        "NOTIFICATION_SENT",
        "NOTIFICATION_ACKNOWLEDGED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "child_enrollment",
        "site",
        "site_session",
        "staff_assignment",
        "pickup_policy",
        "transfer",
        "notification",
        "safeguarding_case"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
